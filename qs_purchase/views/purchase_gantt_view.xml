<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_gantt" model="ir.ui.view">
        <field name="name">purchase.order.gantt</field>
        <field name="model">purchase.order</field>

        <field name="arch" type="xml">
            <gantt string="Purchase Orders"
                   date_start="date_order"
                   date_stop="date_planned"
                   default_scale="week">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>

            </gantt>
        </field>
    </record>

</odoo>