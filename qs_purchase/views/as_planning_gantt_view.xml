<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_as_planning_line_gantt" model="ir.ui.view">
        <field name="name">as.planning.line.gantt</field>
        <field name="model">as.planning.line</field>
        <field name="arch" type="xml">
            <gantt string="Global Planning"
                   date_start="date_start"
                   date_stop="date_stop"
                   default_scale="month"
                   color="record_type"
                   default_group_by="record_type">
                <field name="name"/>
                <field name="record_type"/>
                <field name="partner_id"/>
                <field name="project_id"/>
            </gantt>
        </field>
    </record>

    <record id="view_as_planning_line_tree" model="ir.ui.view">
        <field name="name">as.planning.line.tree</field>
        <field name="model">as.planning.line</field>
        <field name="arch" type="xml">
            <list string="Global Planning">
                <field name="name"/>
                <field name="record_type"/>
                <field name="date_start"/>
                <field name="date_stop"/>
                <field name="partner_id"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

</odoo>